VITE_AUTH_URL=
VITE_API_URL=

# Optional, development only: HTTPS origin of the existing auth service.
# When set, Vite serves HTTPS on localhost:5173 and proxies /api/auth to this origin.
# Pair with VITE_AUTH_URL=https://localhost:5173/api/auth.
DEV_AUTH_PROXY_TARGET=

# Defaults to true. Set false only for local development when Core-auth already
# trusts http://localhost:5173. Upstream HTTPS and cookie attributes stay intact.
DEV_AUTH_PROXY_HTTPS=true
